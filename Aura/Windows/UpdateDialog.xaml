<ContentDialog
    x:Class="Aura.Windows.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:Aura.Utils"
    xmlns:models="using:Aura.Models"
    Title="Update"
    CloseButtonText="Close">

    <ContentDialog.Resources>
        <utils:UpdateStatusToVisibilityConverter x:Key="UpdateStatusToVisibilityConverter" />
        <utils:StringFormatConverter x:Key="StringFormatConverter" />
    </ContentDialog.Resources>

    <Grid Margin="0,10,0,0" Width="300">
        <!-- Checking Status -->
        <StackPanel Spacing="8" Visibility="{Binding Status, Converter={StaticResource UpdateStatusToVisibilityConverter}, ConverterParameter=Checking}">
            <TextBlock Text="Checking for updates..." Style="{ThemeResource BodyTextBlockStyle}" />
            <ProgressBar IsIndeterminate="True" Height="8" />
        </StackPanel>

        <!-- NoUpdate Status -->
        <StackPanel Spacing="8" Visibility="{Binding Status, Converter={StaticResource UpdateStatusToVisibilityConverter}, ConverterParameter=NoUpdate}">
            <TextBlock Text="No new updates found" Style="{ThemeResource BodyTextBlockStyle}" />
        </StackPanel>

        <!-- NewUpdate Status -->
        <StackPanel Spacing="8" Visibility="{Binding Status, Converter={StaticResource UpdateStatusToVisibilityConverter}, ConverterParameter=NewUpdate}">
            <TextBlock Text="{Binding Version, Converter={StaticResource StringFormatConverter}, ConverterParameter='Update to version {0} is now available for download'}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="Changelog" FontWeight="Bold" Style="{ThemeResource BodyTextBlockStyle}" />
            <TextBlock Text="{Binding Changelog}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
            <Button Content="Download now" Click="DownloadButton_Click" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Downloading Status -->
        <StackPanel Spacing="8" Visibility="{Binding Status, Converter={StaticResource UpdateStatusToVisibilityConverter}, ConverterParameter=Downloading}">
            <Grid>
                <TextBlock Text="Downloading update..." Style="{ThemeResource BodyTextBlockStyle}" />
                <TextBlock Text="{Binding Progress, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}" />
            </Grid>
            <ProgressBar Value="{Binding Progress}" Height="8" Maximum="100" />
        </StackPanel>

        <!-- Ready Status -->
        <StackPanel Spacing="8" Visibility="{Binding Status, Converter={StaticResource UpdateStatusToVisibilityConverter}, ConverterParameter=Ready}">
            <TextBlock Text="{Binding Version, Converter={StaticResource StringFormatConverter}, ConverterParameter='Update to version {0} is now ready to be installed'}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <Button Content="Update now" Click="InstallButton_Click" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Error Status -->
        <StackPanel Spacing="8" Visibility="{Binding Status, Converter={StaticResource UpdateStatusToVisibilityConverter}, ConverterParameter=Error}">
            <TextBlock Text="An error has occurred. Please check logs for more info." TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
            <Button Content="Try Again" Click="CheckButton_Click" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</ContentDialog>

