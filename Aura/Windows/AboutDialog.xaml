<ContentDialog
    x:Class="Aura.Windows.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About Aura"
    CloseButtonText="Close"
    DefaultButton="Close">

    <StackPanel Spacing="12" Margin="0,10,0,0">
        <TextBlock Text="Aura Theme Changer" Style="{ThemeResource SubtitleTextBlockStyle}" />
        
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Version" Style="{ThemeResource BodyTextBlockStyle}" />
            <TextBlock x:Name="VersionText" Style="{ThemeResource BodyTextBlockStyle}" />
        </StackPanel>
        
        <Button Content="Check for updates" Click="ButtonCheck_Click" Margin="0,8,0,8" />
        
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Last check:" Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="LastCheckText" Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <HyperlinkButton Content="Creator GitHub Page" NavigateUri="https://github.com/VizXtreme" Padding="0" Margin="0,8,0,0" />
        <HyperlinkButton Content="GitHub Public Repository" NavigateUri="https://github.com/VizXtreme/Aura" Padding="0" />
        <HyperlinkButton Content="Suggestions and Issues" NavigateUri="https://github.com/VizXtreme/Aura/issues" Padding="0" />
    </StackPanel>
</ContentDialog>

